{
  "name": "dsh-desktop",
  "version": "0.3.0",
  "description": "DSH Desktop — codex 桌面端风格的 DeepSeek Harness 原生客户端（零配置开箱即用：窗口/会话菜单/托盘/通知/快速发消息/防休眠/内置终端）",
  "main": "main.js",
  "author": "wuqian",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "make-icons": "node scripts/make-icon.js",
    "release": "node scripts/release.js",
    "dist": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/&& set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DSH Desktop",
    "files": [
      "main.js",
      "preload.js",
      "error.html",
      "send-dialog.html",
      "splash.html",
      "terminal.html",
      "assets/**",
      "node_modules/@xterm/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
